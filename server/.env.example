PORT=3000
NODE_ENV=development

# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# Service role key (optional) — only needed for admin operations that bypass RLS
# Keep this secret! Never expose in client-side code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Redis (optional) ──────────────────────────────────────────────────────────
# Used for leaderboards and caching. Leave blank to disable.
REDIS_URL=redis://localhost:6379

# ── AI Coaching (optional) ────────────────────────────────────────────────────
# For real AI insights (currently uses canned responses)
AI_API_KEY=your-openai-or-anthropic-key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * for all
# Example: http://localhost:8081,https://yourapp.com
CORS_ORIGIN=*
